    "lint:write": "rslint --fix && prettier -w .",
    "test": "rstest"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.13",
    "@rslib/core": "^0.23.2",
    "@rslint/core": "^0.8.0",
    "@rstackjs/test-utils": "^0.2.0",
    "@rstest/core": "^0.11.8",
    "@rstest/playwright": "^0.11.8",
    "@types/node": "^24.13.3",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.21.0",
