{
  "name": "rsbuild-plugin-example",
  "version": "0.0.0",
  "repository": "https://github.com/rstackjs/rsbuild-plugin-template",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
